# Copy to .env for local development. Never commit real credentials:
# feed API keys live in the vault in any deployed environment (spec §11).

AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=false

AEGIS_DATABASE_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
# Shared per-CVE store, tenant registry, and the prefix for per-tenant
# schemas (spec §11: one schema per tenant).
AEGIS_INTEL_SCHEMA=intel
AEGIS_CONTROL_SCHEMA=control
AEGIS_TENANT_SCHEMA_PREFIX=tenant_

AEGIS_BROKER_URL=redis://localhost:6379/0
AEGIS_RESULT_BACKEND=redis://localhost:6379/1

# Optional. Without a key, NVD limits the client to 5 requests / 30s.
# AEGIS_NVD_API_KEY=
# Commercial, licensed feed (spec §4.1).
# AEGIS_VULNCHECK_API_TOKEN=

# --- Exposure verification (spec §6): this sends real traffic ----------
# One TCP connect, one TLS handshake and one HTTP request per match, to the
# single host:port that match names. No scanning, no payloads.
AEGIS_VERIFICATION_ENABLED=true
AEGIS_VERIFICATION_TIMEOUT_SECONDS=6.0
AEGIS_VERIFICATION_PER_HOST_DELAY_SECONDS=0.5
AEGIS_VERIFICATION_TTL_HOURS=24
# Off by default: §6.1 asks whether a service is reachable from the internet.
AEGIS_VERIFICATION_ALLOW_PRIVATE_TARGETS=false

# Live PostgreSQL for the integration tests; unset skips them.
# AEGIS_TEST_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis_test
