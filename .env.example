# Copy to .env for local development. Never commit real credentials:
# feed API keys live in the vault in any deployed environment (spec §11).

AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=false

AEGIS_DATABASE_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
AEGIS_INTEL_SCHEMA=intel

AEGIS_BROKER_URL=redis://localhost:6379/0
AEGIS_RESULT_BACKEND=redis://localhost:6379/1

# Optional. Without a key, NVD limits the client to 5 requests / 30s.
# AEGIS_NVD_API_KEY=
# Commercial, licensed feed (spec §4.1).
# AEGIS_VULNCHECK_API_TOKEN=

# Live PostgreSQL for the integration tests; unset skips them.
# AEGIS_TEST_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis_test
