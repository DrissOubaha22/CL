# Copy to .env for local development. Never commit real credentials:
# feed API keys live in the vault in any deployed environment (spec §11).

AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=false

AEGIS_DATABASE_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
# Shared per-CVE store, tenant registry, and the prefix for per-tenant
# schemas (spec §11: one schema per tenant).
AEGIS_INTEL_SCHEMA=intel
AEGIS_CONTROL_SCHEMA=control
AEGIS_TENANT_SCHEMA_PREFIX=tenant_

AEGIS_BROKER_URL=redis://localhost:6379/0
AEGIS_RESULT_BACKEND=redis://localhost:6379/1

# Optional. Without a key, NVD limits the client to 5 requests / 30s.
# AEGIS_NVD_API_KEY=
# Commercial, licensed feed (spec §4.1).
# AEGIS_VULNCHECK_API_TOKEN=

# --- Exposure verification (spec §6): this sends real traffic ----------
# One TCP connect, one TLS handshake and one HTTP request per match, to the
# single host:port that match names. No scanning, no payloads.
AEGIS_VERIFICATION_ENABLED=true
AEGIS_VERIFICATION_TIMEOUT_SECONDS=6.0
AEGIS_VERIFICATION_PER_HOST_DELAY_SECONDS=0.5
AEGIS_VERIFICATION_TTL_HOURS=24
# Off by default: §6.1 asks whether a service is reachable from the internet.
AEGIS_VERIFICATION_ALLOW_PRIVATE_TARGETS=false

# --- LLM (spec §4.2, §8) -----------------------------------------------
# The model handles unstructured text and drafting only, and never receives
# client-identifying data. Off means bulletins are drafted deterministically.
AEGIS_LLM_ENABLED=true
AEGIS_LLM_PROVIDER=anthropic
AEGIS_LLM_MODEL=claude-opus-5-5
# Required when zero retention is enforced: an ambient credential may belong
# to a retaining account, and §8.3 wants that choice made deliberately.
# AEGIS_LLM_API_KEY=
AEGIS_LLM_REQUIRE_ZERO_RETENTION=true
# A self-hosted model is the other deployment §8.3 allows: set the provider
# to self_hosted and point this at an Anthropic-compatible endpoint.
# AEGIS_LLM_BASE_URL=

# --- SSO (spec §11): the API refuses to start without an issuer --------
AEGIS_OIDC_ISSUER=https://idp.example.com
AEGIS_OIDC_AUDIENCE=aegis-api
# Claim holding {"tenant-slug": ["analyst"]}; unknown role names are dropped.
AEGIS_OIDC_ROLES_CLAIM=aegis_roles
AEGIS_OIDC_PLATFORM_ROLES_CLAIM=aegis_platform_roles

# --- Secrets (spec §11) -------------------------------------------------
# "env" reads AEGIS_SECRET_<NAME>; "file" reads a directory, which is the
# shape a mounted Kubernetes or Vault-agent secret takes.
AEGIS_SECRET_BACKEND=env
# AEGIS_SECRET_FILE_DIR=/var/run/secrets/aegis
AEGIS_SECRET_MAX_AGE_DAYS=90
# Webhook URLs are secrets; destinations store only the name.
# AEGIS_SECRET_SLACK_SOC=https://hooks.slack.com/services/...

# --- Delivery (spec §12) ------------------------------------------------
AEGIS_DELIVERY_ENABLED=true

# Live PostgreSQL for the integration tests; unset skips them.
# AEGIS_TEST_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis_test
